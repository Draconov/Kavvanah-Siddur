{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kavvanah",
  "version": "0.1.0",
  "identifier": "io.github.draconov.kavvanah",
  "build": {
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Kavvanah · Siddur & Tanakh",
        "width": 1180,
        "height": 800,
        "minWidth": 680,
        "minHeight": 560,
        "backgroundColor": "#152443"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
